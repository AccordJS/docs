---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="AccordJS Blog - Discord Bot Development Insights">
  <main class="min-h-screen bg-base-100">
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-primary mb-6">
          Blog
        </h1>
        <p class="text-xl text-base-content/80 mb-8 max-w-2xl mx-auto">
          Insights, tutorials, and updates from the AccordJS development team.
        </p>

        <div class="bg-base-200 rounded-lg p-8 text-left">
          <h2 class="text-2xl font-semibold mb-4 text-primary">Coming Soon</h2>
          <p class="text-base-content/80 mb-4">
            Our blog is launching soon with in-depth articles about Discord bot development,
            AccordJS best practices, and framework updates.
          </p>
          <p class="text-base-content/80 mb-6">
            Stay tuned for content covering:
          </p>

          <ul class="list-disc list-inside text-base-content/80 mb-6 space-y-2">
            <li>Advanced Discord bot architecture patterns</li>
            <li>Event-driven bot development with AccordJS</li>
            <li>Plugin development tutorials</li>
            <li>Performance optimization techniques</li>
            <li>TypeScript best practices for Discord bots</li>
          </ul>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://github.com/AccordJS/accord"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Follow on GitHub
            </a>
            <a
              href="/"
              class="btn btn-outline"
            >
              Back to Home
            </a>
          </div>
        </div>

        <div class="mt-12 bg-base-200 rounded-lg p-6">
          <h3 class="text-xl font-semibold mb-3 text-primary">Get Notified</h3>
          <p class="text-base-content/80">
            Want to be notified when we publish new content? Follow our GitHub repository
            to stay updated on all AccordJS developments and blog posts.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>