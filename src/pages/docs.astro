---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="AccordJS Documentation">
  <main class="min-h-screen bg-base-100">
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-primary mb-6">
          Documentation
        </h1>
        <p class="text-xl text-base-content/80 mb-8 max-w-2xl mx-auto">
          Comprehensive guides and API references for building Discord bots with AccordJS.
        </p>

        <div class="bg-base-200 rounded-lg p-8 text-left">
          <h2 class="text-2xl font-semibold mb-4 text-primary">Coming Soon</h2>
          <p class="text-base-content/80 mb-4">
            Our comprehensive documentation is currently being developed alongside the AccordJS framework.
          </p>
          <p class="text-base-content/80 mb-6">
            In the meantime, you can explore the AccordJS source code and examples on GitHub:
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://github.com/AccordJS/accord"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              View on GitHub
            </a>
            <a
              href="https://github.com/AccordJS/accord/tree/main/examples"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
            >
              Browse Examples
            </a>
          </div>
        </div>

        <div class="mt-12 grid md:grid-cols-3 gap-6 text-left">
          <div class="bg-base-200 rounded-lg p-6">
            <h3 class="text-xl font-semibold mb-3 text-primary">Quick Start</h3>
            <p class="text-base-content/80">
              Get up and running with AccordJS in minutes with our step-by-step guide.
            </p>
          </div>

          <div class="bg-base-200 rounded-lg p-6">
            <h3 class="text-xl font-semibold mb-3 text-primary">API Reference</h3>
            <p class="text-base-content/80">
              Detailed documentation of all AccordJS classes, methods, and interfaces.
            </p>
          </div>

          <div class="bg-base-200 rounded-lg p-6">
            <h3 class="text-xl font-semibold mb-3 text-primary">Plugin Development</h3>
            <p class="text-base-content/80">
              Learn how to extend AccordJS functionality with custom plugins.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>