---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | AccordJS">
    <section class="min-h-screen flex items-center bg-base-100">
        <div class="container mx-auto px-4">
            <div class="text-center max-w-lg mx-auto">
                <div class="mb-6">
                    <div class="text-6xl mb-4">🤖💔</div>
                </div>

                <h1 class="text-6xl md:text-7xl font-bold text-error mb-4">
                    404
                </h1>

                <h2 class="text-2xl md:text-3xl font-bold text-base-content mb-4">
                    Page Not Found
                </h2>

                <p class="text-base-content/70 mb-8">
                    The page you're looking for doesn't exist or has been moved.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/" class="btn btn-primary btn-lg">
                        Back to Home
                    </a>
                    <a href="/docs" class="btn btn-outline btn-lg">
                        Documentation
                    </a>
                </div>

                <div class="mb-8 mt-8 text-sm text-base-content/60">
                    <p>Need help? Check out our <a href="/docs" class="text-primary hover:underline">documentation</a> or <a href="https://github.com/AccordJS/accord" class="text-primary hover:underline">GitHub repository</a>.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>